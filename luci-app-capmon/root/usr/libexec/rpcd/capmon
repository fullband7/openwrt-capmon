#!/bin/sh

. /usr/share/libubox/jshn.sh

fail() {
	printf '{"error":"%s"}\n' "$1"
	exit 0
}

ok() {
	printf '{"result":true}\n'
	exit 0
}

map_rc() {
	case "$1" in
		0) ok ;;
		3) fail not_configured ;;
		5) fail auth ;;
		6) fail offline ;;
		7) fail server ;;
		8) fail bad_data ;;
		9) fail not_synced ;;
		10) fail too_many ;;
		12) fail app_disabled ;;
		13) fail tls ;;
		14) fail insecure ;;
		15) fail bad_backup ;;
		16) fail token_required ;;
		*) fail failed ;;
	esac
}

valid_mac() {
	[ "${#1}" -eq 17 ] || return 1
	case "$1" in
		[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]) return 0 ;;
	esac
	return 1
}

read_input() {
	local raw
	raw=$(head -c 4096)
	[ -n "$raw" ] || fail "empty request"
	json_init
	json_load "$raw" 2> /dev/null || fail "invalid json"
}

get_mac() {
	json_get_var MAC mac
	MAC=$(printf '%s' "$MAC" | tr 'A-F' 'a-f')
	valid_mac "$MAC" || fail "invalid mac address"
}

plan_set() {
	local name limit period enabled speed rc
	read_input
	get_mac
	json_get_var name name
	json_get_var limit limit
	json_get_var period period
	json_get_var enabled enabled
	json_get_var speed speed
	case "$enabled" in
		0|false) enabled=0 ;;
		*) enabled=1 ;;
	esac
	/usr/sbin/capmon plan-set "$MAC" "$name" "$limit" "$period" "$enabled" "$speed" > /dev/null 2>&1
	rc=$?
	[ "$rc" = 1 ] && fail "invalid input"
	map_rc "$rc"
}

plan_del() {
	read_input
	get_mac
	/usr/sbin/capmon plan-del "$MAC" > /dev/null 2>&1
	map_rc "$?"
}

plan_reset() {
	read_input
	get_mac
	/usr/sbin/capmon qreset "$MAC" > /dev/null 2>&1
	map_rc "$?"
}

server_set() {
	local url token rid pin rc
	read_input
	json_get_var url url
	json_get_var token token
	json_get_var rid router_id
	json_get_var pin pin
	CAPMON_TOKEN="$token" /usr/sbin/capmon server-set "$url" "$rid" "$pin" > /dev/null 2>&1
	rc=$?
	[ "$rc" = 1 ] && fail "invalid input"
	map_rc "$rc"
}

server_enable() {
	local enabled
	read_input
	json_get_var enabled enabled
	case "$enabled" in
		0|1) ;;
		*) fail "invalid input" ;;
	esac
	/usr/sbin/capmon server-enable "$enabled" > /dev/null 2>&1
	map_rc "$?"
}

app_enable() {
	local enabled
	read_input
	json_get_var enabled enabled
	case "$enabled" in
		0|1) ;;
		*) fail "invalid input" ;;
	esac
	/usr/sbin/capmon app-enable "$enabled" > /dev/null 2>&1 < /dev/null
	map_rc "$?"
}

ntfy_enable() {
	local enabled
	read_input
	json_get_var enabled enabled
	case "$enabled" in
		0|1) ;;
		*) fail "invalid input" ;;
	esac
	/usr/sbin/capmon ntfy-enable "$enabled" > /dev/null 2>&1 < /dev/null
	map_rc "$?"
}

UPDATE_REPO="fullband7/openwrt-capmon"
UPDATE_PKG="luci-app-capmon"
UPDATE_MAX_BYTES=120000
UPDATE_FIELD_MAX=128
UPDATE_BODY_MAX=10000
UPDATE_CACHE=/var/run/capmon/update.cache
UPDATE_TTL=600
UPDATE_FAIL_TTL=30

json_escape() {
	printf '%s' "$1" \
		| tr -d '\000-\010\013-\037\177' \
		| sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' \
		| sed -e ':a;N;$!ba;s/\n/\\n/g'
}

valid_repo() {
	case "$1" in
		""|/*|*/|*..*|*/*/*|*[!A-Za-z0-9._/-]*) return 1 ;;
		*/*) return 0 ;;
	esac
	return 1
}

get_pkg_manager() {
	if command -v apk > /dev/null 2>&1; then
		echo apk
	else
		echo opkg
	fi
}

get_current_version() {
	if [ "$1" = "apk" ]; then
		apk list --installed "$UPDATE_PKG" 2> /dev/null | sed -n "s/^${UPDATE_PKG}-\([0-9][0-9.]*\).*/\1/p" | head -n 1
	else
		opkg list-installed "$UPDATE_PKG" 2> /dev/null | sed -n "s/^${UPDATE_PKG}[[:space:]]*-[[:space:]]*\([0-9][0-9.]*\).*/\1/p" | head -n 1
	fi
}

strip_v() {
	printf '%s' "$1" | sed -e 's/^[vV]//' -e 's/[[:space:]]//g'
}

is_release_url() {
	case "$1" in
		"https://github.com/$UPDATE_REPO/releases/download/"?*) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*..*|*[!A-Za-z0-9._~:/%+@=-]*) return 1 ;;
	esac
	return 0
}

fetch_release() {
	curl -q -sS --fail --connect-timeout 5 --max-time 15 --max-filesize "$UPDATE_MAX_BYTES" \
		--proto '=https' --tlsv1.2 \
		-H 'Accept: application/vnd.github+json' -A 'OpenWrt-LuCI-Updater/1.0' \
		--url "https://api.github.com/repos/$UPDATE_REPO/releases/latest" 2> /dev/null | head -c "$UPDATE_MAX_BYTES"
}

fetch_release_cached() {
	local ts=0 now age body
	now=$(date +%s)
	if [ -r "$UPDATE_CACHE" ]; then
		read -r ts < "$UPDATE_CACHE"
		case "$ts" in
			""|*[!0-9]*) ts=0 ;;
		esac
		age=$((now - ts))
		body=$(tail -n +2 "$UPDATE_CACHE" | head -c "$UPDATE_MAX_BYTES")
		if [ "$age" -ge 0 ]; then
			if [ -n "$body" ] && [ "$age" -lt "$UPDATE_TTL" ]; then
				printf '%s' "$body"
				return 0
			fi
			[ -z "$body" ] && [ "$age" -lt "$UPDATE_FAIL_TTL" ] && return 0
		fi
	fi
	body=$(fetch_release)
	[ -d /var/run/capmon ] || { mkdir -p /var/run/capmon && chmod 700 /var/run/capmon; }
	{ printf '%s\n' "$now"; printf '%s' "$body"; } > "$UPDATE_CACHE.new" && mv "$UPDATE_CACHE.new" "$UPDATE_CACHE"
	printf '%s' "$body"
}

update_error() {
	printf '{"error":"%s","update_available":false,"current_version":"%s","pkg_manager":"%s"}\n' \
		"$1" "$(json_escape "$current_ver")" "$pkg_mgr"
}

check_update() {
	local raw tag name body raw_assets assets_json download_url fallback_url pkg_ext a
	local latest_clean current_clean update_available

	umask 077

	pkg_mgr=$(get_pkg_manager)
	current_ver=$(get_current_version "$pkg_mgr")
	current_ver=${current_ver%%-*}
	current_ver=${current_ver%.}
	[ -n "$current_ver" ] || current_ver="unknown"

	valid_repo "$UPDATE_REPO" || { update_error repo; return; }

	raw=$(fetch_release_cached)
	[ -n "$raw" ] || { update_error unreachable; return; }
	tag=$(jsonfilter -s "$raw" -e '@.tag_name' 2> /dev/null | head -c "$UPDATE_FIELD_MAX")
	[ -n "$tag" ] || { update_error parse; return; }
	case "$tag" in
		*[!A-Za-z0-9._+-]*) update_error parse; return ;;
	esac
	name=$(jsonfilter -s "$raw" -e '@.name' 2> /dev/null | head -c "$UPDATE_FIELD_MAX")
	body=$(jsonfilter -s "$raw" -e '@.body' 2> /dev/null | head -c "$UPDATE_BODY_MAX")
	raw_assets=$(jsonfilter -s "$raw" -e '@.assets[*].browser_download_url' 2> /dev/null)
	[ -n "$name" ] || name="$tag"

	assets_json=""
	download_url=""
	fallback_url=""
	pkg_ext="ipk"
	[ "$pkg_mgr" = "apk" ] && pkg_ext="apk"
	while IFS= read -r a; do
		[ -n "$a" ] || continue
		is_release_url "$a" || continue
		assets_json="$assets_json\"$(json_escape "$a")\","
		case "$a" in
			*.*"$pkg_ext") [ -n "$download_url" ] || download_url="$a" ;;
		esac
		case "$a" in
			*.ipk|*.apk) [ -n "$fallback_url" ] || fallback_url="$a" ;;
		esac
	done <<EOF
$raw_assets
EOF
	[ -n "$download_url" ] || download_url="$fallback_url"
	assets_json=$(printf '%s' "$assets_json" | sed 's/,$//')

	latest_clean=$(strip_v "$tag")
	current_clean=$(strip_v "$current_ver")
	if [ "${latest_clean%%-*}" = "${current_clean%%-*}" ]; then
		update_available="false"
	else
		update_available="true"
	fi

	printf '{"current_version":"%s","latest_version":"%s","release_title":"%s","release_notes":"%s","assets":[%s],"download_url":"%s","update_available":%s,"pkg_manager":"%s"}\n' \
		"$(json_escape "$current_ver")" "$(json_escape "$tag")" "$(json_escape "$name")" "$(json_escape "$body")" "$assets_json" "$(json_escape "$download_url")" "$update_available" "$pkg_mgr"
}

case "$1" in
	list)
		printf '{"get":{},"reset":{},"sync":{},"server_get":{},"server_set":{"url":"","token":"","router_id":"","pin":""},"server_enable":{"enabled":""},"app_enable":{"enabled":""},"ntfy_get":{},"ntfy_enable":{"enabled":""},"ntfy_reset":{},"plan_set":{"mac":"","name":"","limit":"","period":"","enabled":"","speed":""},"plan_del":{"mac":""},"plan_reset":{"mac":""},"export":{},"import":{},"check_update":{}}\n'
		;;
	call)
		case "$2" in
			get)
				cat > /dev/null
				exec /usr/sbin/capmon json
				;;
			server_get)
				cat > /dev/null
				exec /usr/sbin/capmon server-get
				;;
			reset)
				cat > /dev/null
				/usr/sbin/capmon reset > /dev/null 2>&1
				map_rc "$?"
				;;
			sync)
				cat > /dev/null
				/usr/sbin/capmon syncnow > /dev/null 2>&1
				map_rc "$?"
				;;
			export)
				cat > /dev/null
				exec /usr/sbin/capmon export-json
				;;
			import)
				cat > /dev/null
				/usr/sbin/capmon import > /dev/null 2>&1 < /dev/null
				map_rc "$?"
				;;
			ntfy_get)
				cat > /dev/null
				exec /usr/sbin/capmon ntfy-get
				;;
			server_set) server_set ;;
			server_enable) server_enable ;;
			app_enable) app_enable ;;
			ntfy_enable) ntfy_enable ;;
			ntfy_reset)
				cat > /dev/null
				/usr/sbin/capmon ntfy-reset > /dev/null 2>&1 < /dev/null
				map_rc "$?"
				;;
			plan_set) plan_set ;;
			plan_del) plan_del ;;
			plan_reset) plan_reset ;;
			check_update) check_update ;;
			*) fail "unknown method" ;;
		esac
		;;
esac

exit 0
