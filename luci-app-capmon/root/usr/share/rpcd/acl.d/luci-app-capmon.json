{
	"luci-app-capmon": {
		"description": "Grant access to Quota Manager",
		"read": {
			"ubus": {
				"capmon": [ "get", "server_get", "check_update" ],
				"luci-rpc": [ "getHostHints" ]
			}
		},
		"write": {
			"cgi-io": [ "upload" ],
			"file": {
				"/var/run/capmon/import.up": [ "write" ]
			},
			"ubus": {
				"capmon": [ "reset", "sync", "server_set", "server_enable", "app_enable", "ntfy_enable", "ntfy_get", "ntfy_reset", "export", "plan_set", "plan_del", "plan_reset", "import" ]
			}
		}
	}
}
