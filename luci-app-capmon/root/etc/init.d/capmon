#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	[ "$(uci -q get capmon.main.enabled)" = "0" ] && return 0
	/usr/sbin/capmon start
	procd_open_instance
	procd_set_param command /usr/sbin/capmon daemon
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/sbin/capmon stop
}

reload_service() {
	/usr/sbin/capmon refresh
}

service_triggers() {
	procd_add_reload_trigger capmon
}
