#!/bin/sh

case "$ACTION" in
	add|update) ;;
	*) exit 0 ;;
esac

[ -s /var/run/capmon/plans ] || exit 0
[ -d /var/run/capmon/bind.pending ] && exit 0

case "$MACADDR" in
	"") exit 0 ;;
esac

grep -qiF -- "$MACADDR" /var/run/capmon/plans 2> /dev/null || exit 0

[ "$(uci -q get capmon.main.enabled)" = "0" ] && exit 0

/usr/sbin/capmon bind > /dev/null 2>&1 &

exit 0
